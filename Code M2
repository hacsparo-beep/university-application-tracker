import datetime
name_file= "universities.txt"
application_file = "applications.txt"
document_file = "document.txt"
application_status= ("in progress", "not started", "submitted")

class Myuniversitylist(name, deadline, country, decision_track):
  def __init__(self, university_name, deadline, university_country, decision_track):
      self.university_name= university_name
      self.deadline = deadline
      self.university_country = country
      self.application_track = application_track

class Application():
    def __init__(self, university_name, status):
        self.university_name = university_name
        self.status = status

def read_universities(university_file):
    universities = []
    try: 
        file = open(university_file, "r")
        name = file.readline()
        while name != "":
              name = name.replace("\n", "")
              country = file.readline().replace("\n", "")
              deadline = file.readline().replace("\n", "")
              track = file.readline().replace("\n", "")
              universities.append(Myuniversitylist(name, deadline, country, decision_track)
              name= file.readline()
         file.close()
      except FileNotFoundError:
         print("File not found:", university_file)
      return universities

def read_application(application_file):
    file = open(application_file, "r")
    application = []
    try:
            name = file.readline().replace("\n", "")
            status = file.readline().replace("\n", "")
            if status in application_status:
                applications.append(Application(name, status))
            else:
                print("record not found:", name)
            name = file.readline()
        file.close()
    except FileNotFoundError:
        print("File not found:", application_file)
    return applications

def read_documents(file_name):
    documents = []
    try:
        file = open(file_name, "r")
        for line in file: 
             documents.append(line.replace("\n", "")
        file.close()
    except FileNotFoundError:
        print("File not found:", file_name)
    return documents

def add_university(universities, university_name, deadline, university_country, app_type):
    if university_name == "" or university_country == "" or app_type == "":
        return "Please fill in every box."
    universities.append(Myuniversitylist(university_name, deadline, university_country, app_type)
    return "University saved: " + university_name

def remove_university(universities, university_name):
    for university in universities:
        if university.university_name == university_name:
            universities.remove(university)
            return "University removed."
    return "University not found."

def list_universities(universities):
    lines = []
    for university in universities:
        lines.append(university.university_name + ", " + university.university_country + ", " + university.deadline + ", " + university.application_track)
    return lines

def start_application(universities, applications, university_name):
    for university in universities:
        if university.university_name == university_name:
            applications.append(Application(university_name, "not started"))
            return "Application saved: " + university_name
    return "University not found."

def update_status(applications, university_name, new_status):
    if new_status not in application_status:
        return "The status must be not started, in progress or submitted."
    for application in applications:
        if application.university_name == university_name:
            application.status = new_status
            return "Status updated."
    return "Application not found."

def search_applications(applications, university_name):
    lines = []
    for application in applications:
        if application.university_name == university_name:
            lines.append(application.university_name + " " + application.status)
    return lines

def add_document(documents, university_name, document_name):
    if document_name == "":
        return "Please type a document name."
    documents.append(university_name + " " + document_name)
    return "Document saved."

def change_document(documents, university_name, old_name, new_name):
    old = university_name + " " + old_name
    if old in documents:
        documents.remove(old)
        documents.append(university_name + "  " + new_name)
        return "Document changed."
    return "Document not found."

def remove_document(documents, university_name, document_name):
    document = university_name + " " + document_name
    if document in documents:
        documents.remove(document)
        return "Document removed."
    return "Document not found."

